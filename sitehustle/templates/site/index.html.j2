<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.name }}{% if r.city %} | {{ r.cuisine_label or "Restaurant" }} in {{ r.city }}{% endif %}</title>
<meta name="description" content="{{ r.meta_description }}">
{% if preview %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ theme.display_font_url }}&family={{ theme.body_font_url }}&display=swap" rel="stylesheet">
<style>
:root{
  --bg:{{ theme.bg }}; --surface:{{ theme.surface }}; --ink:{{ theme.ink }}; --muted:{{ theme.muted }};
  --accent:{{ theme.accent }}; --accent-ink:{{ theme.accent_ink }}; --line:{{ theme.line }};
  --display:'{{ theme.display_font }}', Georgia, serif; --body:'{{ theme.body_font }}', system-ui, sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font:17px/1.6 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit}
img{max-width:100%;display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
.preview-bar{background:#111;color:#fff;font:14px/1.4 system-ui,sans-serif;text-align:center;padding:10px 16px}
.preview-bar a{color:#ffd76a;font-weight:600}
header.nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
header.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.brand{font:700 1.35rem/1 var(--display);text-decoration:none;letter-spacing:.01em}
.nav-links{display:flex;gap:22px;align-items:center;font-size:.95rem}
.nav-links a{text-decoration:none;color:var(--muted)}
.nav-links a:hover{color:var(--ink)}
.btn{white-space:nowrap;display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:var(--accent-ink)!important;text-decoration:none;font-weight:600;padding:12px 22px;border-radius:999px;border:2px solid var(--accent);transition:transform .15s ease}
.btn:hover{transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--ink)!important;border-color:var(--ink)}
.nav .btn{padding:9px 18px;font-size:.92rem}
.hero{position:relative;min-height:min(82vh,720px);display:flex;align-items:flex-end;color:#fff;overflow:hidden;
  background:{% if r.hero_image %}linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.72)),url('{{ r.hero_image }}') center/cover{% else %}radial-gradient(1200px 600px at 80% -10%,color-mix(in srgb,var(--accent) 70%,#fff) 0%,transparent 60%),linear-gradient(135deg,{{ theme.hero_a }},{{ theme.hero_b }}){% endif %}}
.hero .wrap{padding-bottom:72px;padding-top:120px;width:100%}
.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.8rem;opacity:.85;margin-bottom:14px}
.hero h1{font:700 clamp(2.6rem,7vw,5.2rem)/1.02 var(--display);max-width:14ch;margin-bottom:18px}
.hero p.lede{font-size:clamp(1.05rem,2.2vw,1.3rem);max-width:46ch;opacity:.92;margin-bottom:28px}
.hero .actions{display:flex;flex-wrap:wrap;gap:12px}
.hero .btn.ghost{color:#fff!important;border-color:#fff}
.quick{background:var(--surface);border-bottom:1px solid var(--line)}
.quick .wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:0}
.quick div{padding:22px 20px;border-right:1px solid var(--line)}
.quick div:last-child{border-right:0}
.quick b{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin-bottom:4px;font-weight:600}
section{padding:88px 0}
h2{font:700 clamp(2rem,4.5vw,3rem)/1.1 var(--display);margin-bottom:16px}
.sub{color:var(--muted);max-width:60ch;margin-bottom:40px}
.about{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.about .photo{aspect-ratio:4/5;border-radius:18px;background:{% if r.about_image %}url('{{ r.about_image }}') center/cover{% else %}linear-gradient(160deg,{{ theme.hero_b }},{{ theme.hero_a }}){% endif %};box-shadow:0 30px 60px -30px rgba(0,0,0,.45)}
.about p+p{margin-top:14px}
.about.solo{grid-template-columns:1fr;max-width:760px}
.about.solo p{font-size:1.12rem}
.menu{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.menu-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}
.menu-tabs button{font:600 .92rem var(--body);background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer}
.menu-tabs button[aria-selected=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.menu-section{display:none}
.menu-section.active{display:block}
.menu-section .note{color:var(--muted);margin:-20px 0 24px;font-style:italic}
.items{display:grid;grid-template-columns:1fr 1fr;gap:6px 56px}
.item{padding:16px 0;border-bottom:1px dashed var(--line)}
.item .row{display:flex;align-items:baseline;gap:12px}
.item .name{font-weight:600}
.item .dots{flex:1;border-bottom:1px dotted var(--line);transform:translateY(-4px)}
.item .price{font-weight:600;color:var(--accent);white-space:nowrap}
.item .desc{color:var(--muted);font-size:.95rem;margin-top:2px}
.menu-cta{margin-top:40px;display:flex;flex-wrap:wrap;gap:12px}
.visit{display:grid;grid-template-columns:1fr 1.2fr;gap:48px}
.hours{width:100%;border-collapse:collapse;margin:8px 0 28px}
.hours td{padding:10px 0;border-bottom:1px solid var(--line)}
.hours td:last-child{text-align:right;color:var(--muted)}
.hours tr.today td{font-weight:700;color:var(--ink)}
.map{border:0;width:100%;height:100%;min-height:380px;border-radius:18px;filter:saturate(.9)}
.contact-list{list-style:none;display:grid;gap:10px;margin-bottom:28px}
.contact-list a{text-decoration:none;border-bottom:1px solid var(--line)}
.reviews{text-align:center}
.quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:32px;text-align:left}
.quote{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:26px}
.quote p{font:500 1.08rem/1.5 var(--display);margin-bottom:12px}
.quote span{color:var(--muted);font-size:.9rem}
footer{background:var(--ink);color:var(--bg);padding:48px 0 32px}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px}
footer .brand{color:var(--bg)}
footer small{opacity:.6;display:block;margin-top:24px;width:100%}
.mobile-bar{display:none}
@media (max-width:820px){
  .nav-links a:not(.btn){display:none}
  .brand{font-size:1.1rem}
  .quick .wrap{grid-template-columns:1fr}
  .quick div{border-right:0;border-bottom:1px solid var(--line);padding:14px 20px}
  .about,.visit{grid-template-columns:1fr;gap:32px}
  .about .photo{aspect-ratio:16/10;order:-1}
  .items{grid-template-columns:1fr}
  section{padding:64px 0}
  .map{min-height:300px}
  .mobile-bar{display:grid;grid-template-columns:repeat({{ 3 if r.order_url else 2 }},1fr);position:fixed;bottom:0;left:0;right:0;z-index:30;background:var(--ink);border-top:1px solid var(--line)}
  .mobile-bar a{color:var(--bg);text-decoration:none;text-align:center;padding:14px 4px;font-weight:600;font-size:.95rem}
  .mobile-bar a+a{border-left:1px solid rgba(255,255,255,.15)}
  body{padding-bottom:52px}
}
</style>
<script type="application/ld+json">{{ r.jsonld | safe }}</script>
</head>
<body>
{% if preview %}
<div class="preview-bar">Free concept preview made for <strong>{{ r.name }}</strong> by {{ biz.name }}. Not live. <a href="{{ r.claim_url }}">Make it yours</a></div>
{% endif %}

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top">{{ r.name }}</a>
    <nav class="nav-links">
      {% if r.about %}<a href="#about">About</a>{% endif %}
      {% if r.menu %}<a href="#menu">Menu</a>{% endif %}
      <a href="#visit">Hours &amp; Location</a>
      {% if r.order_url %}<a class="btn" href="{{ r.order_url }}">Order Online</a>{% elif r.phone %}<a class="btn" href="tel:{{ r.phone_tel }}">Call</a>{% endif %}
    </nav>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">{{ r.cuisine_label or "Restaurant" }}{% if r.city %} &middot; {{ r.city }}{% endif %}</div>
      <h1>{{ r.headline or r.name }}</h1>
      <p class="lede">{{ r.tagline }}</p>
      <div class="actions">
        {% if r.menu %}<a class="btn" href="#menu">View Menu</a>{% endif %}
        {% if r.order_url %}<a class="btn ghost" href="{{ r.order_url }}">Order Online</a>
        {% elif r.reservation_url %}<a class="btn ghost" href="{{ r.reservation_url }}">Reserve a Table</a>
        {% elif r.phone %}<a class="btn ghost" href="tel:{{ r.phone_tel }}">{{ r.phone }}</a>{% endif %}
      </div>
    </div>
  </section>

  <div class="quick">
    <div class="wrap">
      <div><b>Today</b><span id="today-hours">See hours below</span></div>
      <div><b>Find us</b>{{ r.address_short or r.address }}</div>
      <div><b>Call</b>{% if r.phone %}<a href="tel:{{ r.phone_tel }}">{{ r.phone }}</a>{% else %}&mdash;{% endif %}</div>
    </div>
  </div>

  {% if r.about %}
  <section id="about">
    <div class="wrap about{% if not r.about_image %} solo{% endif %}">
      <div>
        <h2>{{ r.about_title or "Our story" }}</h2>
        {% for p in r.about %}<p>{{ p }}</p>{% endfor %}
      </div>
      {% if r.about_image %}<div class="photo" role="img" aria-label="{{ r.name }}"></div>{% endif %}
    </div>
  </section>
  {% endif %}

  {% if r.menu %}
  <section id="menu" class="menu">
    <div class="wrap">
      <h2>Menu</h2>
      <p class="sub">{{ r.menu_intro or "Made fresh, every day." }}</p>
      {% if r.menu|length > 1 %}
      <div class="menu-tabs" role="tablist">
        {% for s in r.menu %}<button role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-tab="m{{ loop.index }}">{{ s.section }}</button>{% endfor %}
      </div>
      {% endif %}
      {% for s in r.menu %}
      <div class="menu-section{% if loop.first %} active{% endif %}" id="m{{ loop.index }}" role="tabpanel">
        {% if s.note %}<p class="note">{{ s.note }}</p>{% endif %}
        <div class="items">
          {% for it in s['items'] %}
          <div class="item">
            <div class="row"><span class="name">{{ it.name }}</span>{% if it.price %}<span class="dots"></span><span class="price">{{ it.price }}</span>{% endif %}</div>
            {% if it.desc %}<div class="desc">{{ it.desc }}</div>{% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <div class="menu-cta">
        {% if r.order_url %}<a class="btn" href="{{ r.order_url }}">Order Online</a>{% endif %}
        {% if r.phone %}<a class="btn ghost" href="tel:{{ r.phone_tel }}">Call to Order</a>{% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if r.reviews %}
  <section class="reviews">
    <div class="wrap">
      <h2>What guests say</h2>
      <div class="quotes">
        {% for q in r.reviews %}<div class="quote"><p>&ldquo;{{ q.text }}&rdquo;</p><span>{{ q.author }}</span></div>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section id="visit">
    <div class="wrap visit">
      <div>
        <h2>Visit us</h2>
        {% if r.hours %}
        <table class="hours" id="hours">
          {% for h in r.hours %}<tr data-days="{{ h.dow|default('') }}"><td>{{ h.days }}</td><td>{{ h.time }}</td></tr>{% endfor %}
        </table>
        {% endif %}
        <ul class="contact-list">
          {% if r.address %}<li><a href="https://www.google.com/maps/dir/?api=1&destination={{ r.address|urlencode }}">{{ r.address }}</a></li>{% endif %}
          {% if r.phone %}<li><a href="tel:{{ r.phone_tel }}">{{ r.phone }}</a></li>{% endif %}
          {% if r.email %}<li><a href="mailto:{{ r.email }}">{{ r.email }}</a></li>{% endif %}
        </ul>
        <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination={{ r.address|urlencode }}">Get Directions</a>
      </div>
      {% if r.address %}<iframe class="map" loading="lazy" title="Map to {{ r.name }}" src="https://www.google.com/maps?q={{ (r.name ~ ', ' ~ r.address)|urlencode }}&output=embed"></iframe>{% endif %}
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div>
      <div class="brand">{{ r.name }}</div>
      <div style="opacity:.75;margin-top:8px">{{ r.address }}</div>
    </div>
    <div style="display:flex;gap:18px;align-items:center">
      {% for label, url in (r.social or {}).items() %}<a href="{{ url }}" style="text-decoration:none;opacity:.85">{{ label|title }}</a>{% endfor %}
    </div>
    <small>&copy; {{ year }} {{ r.name }}. Site by {{ biz.name }}.</small>
  </div>
</footer>

<nav class="mobile-bar">
  {% if r.phone %}<a href="tel:{{ r.phone_tel }}">Call</a>{% endif %}
  <a href="https://www.google.com/maps/dir/?api=1&destination={{ r.address|urlencode }}">Directions</a>
  {% if r.order_url %}<a href="{{ r.order_url }}">Order</a>{% endif %}
</nav>

<script>
document.querySelectorAll('.menu-tabs button').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.menu-tabs button').forEach(x=>x.setAttribute('aria-selected','false'));
  document.querySelectorAll('.menu-section').forEach(x=>x.classList.remove('active'));
  b.setAttribute('aria-selected','true');document.getElementById(b.dataset.tab).classList.add('active');
}));
(function(){var d=new Date().getDay(),rows=document.querySelectorAll('#hours tr'),t=document.getElementById('today-hours');
rows.forEach(function(r){var s=(r.dataset.days||'').split(',').map(Number);if(s.indexOf(d)>-1){r.classList.add('today');if(t)t.textContent=r.cells[1].textContent;}});})();
</script>
</body>
</html>
